CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n

# Console over the native USB port (usbmodemXXXX), not UART0's physical
# GPIO pins -- UART0 is the default primary console on this board but
# nothing is wired to its RX pin, so stdin never received anything.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# BLE init + the USB-CDC console driver together overflow the default 3584B
# main task stack.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# lampify's protocol needs the legacy (BLE 4.2) raw advertising API
# (esp_ble_gap_config_adv_data_raw / start_advertising / stop_advertising).
# BLE 5.0 extended-advertising mode replaces those with a different API
# and is mutually exclusive with 4.2, so it must be turned off explicitly.
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_42_ADV_EN=y
